import java.util.*;
import java.io.*;

class JavaLoopsII{
    public static void main(String []argh){
        Scanner in = new Scanner(System.in);
        int sum;
        int val;
        int t=in.nextInt();
        for(int i=0;i<t;i++){
            int a = in.nextInt();
            int b = in.nextInt();
            int n = in.nextInt();
            sum=0;
            val=1;
            for(int j=1;j<=n;j++)
            {
                if(j==1)
                {
                    val=j;
                    sum+=a;
                }
                else if (j==2)
                val=j;
                else
                val*=2;
                sum+=(b*val);
                System.out.print(sum+" ");
            }
            System.out.println();
        }
        in.close();
    }
}
