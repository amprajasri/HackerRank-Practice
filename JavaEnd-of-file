import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;
import java.util.Scanner;
public class JavaEndOfFile {

    public static void main(String[] args) {
    Scanner input=new Scanner(System.in);
    int i=1;
    String s;
       while(input.hasNextLine())
       {
            s=input.nextLine();
            System.out.println(i+" "+s);
            i++;
       }
    }
}
